#:import dp kivy.metrics.dp
#:import sp kivy.metrics.sp


<ForgotPasswordScreen>:

    # ======================================================
    # BACKGROUND
    # ======================================================

    canvas.before:

        Color:
            rgba: 0.97, 0.96, 1, 1

        Rectangle:
            pos: self.pos
            size: self.size


    # ======================================================
    # MAIN VERTICAL LAYOUT
    # ======================================================

    MDBoxLayout:

        orientation: "vertical"


        # ==================================================
        # TOP APP BAR
        # ==================================================

        MDTopAppBar:

            title: "Forgot Password"

            elevation: 2

            left_action_items:
                [["arrow-left", lambda x: root.go_back()]]


        # ==================================================
        # CONTENT
        # ==================================================

        ScrollView:

            do_scroll_x: False
            do_scroll_y: True

            bar_width: 0


            MDBoxLayout:

                orientation: "vertical"

                size_hint_y: None

                height: self.minimum_height

                padding:
                    dp(28), dp(35), dp(28), dp(35)

                spacing: dp(12)


                # ==========================================
                # ICON
                # ==========================================

                MDIcon:

                    icon: "lock-reset"

                    halign: "center"

                    font_size: dp(65)

                    theme_text_color: "Custom"

                    text_color:
                        0.35, 0.15, 0.65, 1

                    size_hint_y: None

                    height: dp(75)


                # ==========================================
                # TITLE
                # ==========================================

                MDLabel:

                    text: "Reset Your Password"

                    halign: "center"

                    font_style: "H5"

                    bold: True

                    theme_text_color: "Primary"

                    size_hint_y: None

                    height: dp(45)


                # ==========================================
                # DESCRIPTION
                # ==========================================

                MDLabel:

                    text:
                        "Enter your registered email and create a new password."

                    halign: "center"

                    theme_text_color: "Secondary"

                    font_size: sp(12)

                    text_size:
                        self.width, None

                    size_hint_y: None

                    height: dp(55)


                # ==========================================
                # EMAIL
                # ==========================================

                MDTextField:

                    id: email_field

                    hint_text: "Registered Email"

                    icon_left: "email-outline"

                    mode: "rectangle"

                    helper_text:
                        root.email_error

                    helper_text_mode:
                        "on_error"

                    error:
                        bool(root.email_error)

                    size_hint_y: None

                    height: dp(60)


                # ==========================================
                # NEW PASSWORD
                # ==========================================

                MDBoxLayout:

                    orientation: "horizontal"

                    size_hint_y: None

                    height: dp(60)

                    spacing: dp(5)


                    MDTextField:

                        id: password_field

                        hint_text:
                            "New Password"

                        icon_left:
                            "lock-outline"

                        mode:
                            "rectangle"

                        password:
                            not root.password_visible

                        helper_text:
                            root.password_error

                        helper_text_mode:
                            "on_error"

                        error:
                            bool(root.password_error)

                        size_hint_x: 0.85

                        size_hint_y: None

                        height: dp(60)


                    MDIconButton:

                        icon:
                            "eye-off-outline" \
                            if not root.password_visible \
                            else "eye-outline"

                        size_hint_x: 0.15

                        on_release:
                            root.toggle_password()


                # ==========================================
                # CONFIRM PASSWORD
                # ==========================================

                MDBoxLayout:

                    orientation: "horizontal"

                    size_hint_y: None

                    height: dp(60)

                    spacing: dp(5)


                    MDTextField:

                        id: confirm_password_field

                        hint_text:
                            "Confirm New Password"

                        icon_left:
                            "lock-check-outline"

                        mode:
                            "rectangle"

                        password:
                            not root.confirm_password_visible

                        helper_text:
                            root.confirm_error

                        helper_text_mode:
                            "on_error"

                        error:
                            bool(root.confirm_error)

                        size_hint_x: 0.85

                        size_hint_y: None

                        height: dp(60)


                    MDIconButton:

                        icon:
                            "eye-off-outline" \
                            if not root.confirm_password_visible \
                            else "eye-outline"

                        size_hint_x: 0.15

                        on_release:
                            root.toggle_confirm_password()


                # ==========================================
                # RESET BUTTON
                # ==========================================

                MDRaisedButton:

                    text: "RESET PASSWORD"

                    size_hint_x: 1

                    size_hint_y: None

                    height: dp(52)

                    md_bg_color:
                        0.35, 0.15, 0.65, 1

                    theme_text_color:
                        "Custom"

                    text_color:
                        1, 1, 1, 1

                    on_release:
                        root.reset_password()


                # ==========================================
                # SUCCESS MESSAGE
                # ==========================================

                MDLabel:

                    text: root.message

                    halign: "center"

                    theme_text_color:
                        "Custom"

                    text_color:
                        0.15, 0.55, 0.20, 1

                    font_size: sp(12)

                    text_size:
                        self.width, None

                    size_hint_y: None

                    height:
                        dp(50) if root.message else dp(5)


                # ==========================================
                # GENERAL ERROR
                # ==========================================

                MDLabel:

                    text: root.general_error

                    halign: "center"

                    theme_text_color:
                        "Custom"

                    text_color:
                        0.85, 0.08, 0.08, 1

                    font_size: sp(12)

                    text_size:
                        self.width, None

                    size_hint_y: None

                    height:
                        dp(35) if root.general_error else dp(5)


                # ==========================================
                # BACK TO LOGIN
                # ==========================================

                MDTextButton:

                    text: "Back to Login"

                    pos_hint:
                        {"center_x": 0.5}

                    theme_text_color:
                        "Custom"

                    text_color:
                        0.35, 0.15, 0.65, 1

                    size_hint_y: None

                    height: dp(45)

                    on_release:
                        root.go_back()


                Widget:

                    size_hint_y: None

                    height: dp(20)