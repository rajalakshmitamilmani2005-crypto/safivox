#:import dp kivy.metrics.dp
#:import sp kivy.metrics.sp

<LoginScreen>:

    canvas.before:
        Color:
            rgba: 0.97, 0.96, 1, 1

        Rectangle:
            pos: self.pos
            size: self.size

    ScrollView:
        do_scroll_x: False
        do_scroll_y: True
        bar_width: 0

        MDBoxLayout:
            orientation: "vertical"

            size_hint_y: None
            height: self.minimum_height

            padding:
                dp(28), dp(35), dp(28), dp(35)

            spacing: dp(12)

            # ==============================================
            # LOGO
            # ==============================================

            Image:
                source: "assets/app_icon.png"

                size_hint: None, None
                size: dp(90), dp(90)

                pos_hint:
                    {"center_x": 0.5}

            # ==============================================
            # TITLE
            # ==============================================

            MDLabel:
                text: "Welcome to Safivox"

                halign: "center"

                font_style: "H5"
                bold: True

                size_hint_y: None
                height: dp(45)

            MDLabel:
                text: "Sign in to continue"

                halign: "center"

                theme_text_color: "Secondary"

                font_size: sp(13)

                size_hint_y: None
                height: dp(30)

            Widget:
                size_hint_y: None
                height: dp(10)

            # ==============================================
            # EMAIL
            # ==============================================

            MDTextField:
                id: email_field

                hint_text: "Email Address"

                icon_left: "email-outline"

                mode: "rectangle"

                helper_text: root.email_error

                helper_text_mode: "on_error"

                error:
                    bool(root.email_error)

                size_hint_y: None
                height: dp(60)

            # ==============================================
            # PASSWORD
            # ==============================================

            MDBoxLayout:
                orientation: "horizontal"

                size_hint_y: None
                height: dp(60)

                spacing: dp(5)

                MDTextField:
                    id: password_field

                    hint_text: "Password"

                    icon_left: "lock-outline"

                    mode: "rectangle"

                    password:
                        not root.password_visible

                    helper_text:
                        root.password_error

                    helper_text_mode: "on_error"

                    error:
                        bool(root.password_error)

                    size_hint_x: 0.85

                    size_hint_y: None
                    height: dp(60)

                    on_text_validate:
                        root.login()

                MDIconButton:
                    icon:
                        "eye-off-outline" \
                        if not root.password_visible \
                        else "eye-outline"

                    size_hint_x: 0.15

                    on_release:
                        root.toggle_password()

            # ==============================================
            # FORGOT PASSWORD
            # ==============================================

            MDTextButton:
                text: "Forgot Password?"

                pos_hint:
                    {"right": 1}

                theme_text_color: "Custom"

                text_color:
                    0.35, 0.15, 0.65, 1

                size_hint_y: None
                height: dp(40)

                on_release:
                    root.forgot_password()

            # ==============================================
            # LOGIN
            # ==============================================

            MDRaisedButton:
                text: "LOGIN"

                size_hint_x: 1

                size_hint_y: None
                height: dp(52)

                md_bg_color:
                    0.35, 0.15, 0.65, 1

                on_release:
                    root.login()

            # ==============================================
            # GENERAL MESSAGE
            # ==============================================

            MDLabel:
                text: root.general_error

                halign: "center"

                theme_text_color: "Custom"

                text_color:
                    0.85, 0.08, 0.08, 1

                text_size:
                    self.width, None

                size_hint_y: None

                height:
                    dp(35) if root.general_error else dp(5)

            # ==============================================
            # OR
            # ==============================================

            MDLabel:
                text: "────────  OR  ────────"

                halign: "center"

                theme_text_color: "Secondary"

                size_hint_y: None
                height: dp(35)

            # ==============================================
            # GOOGLE
            # ==============================================

            MDRaisedButton:
                text: "CONTINUE WITH GOOGLE"

                size_hint_x: 1

                size_hint_y: None
                height: dp(52)

                md_bg_color:
                    1, 1, 1, 1

                theme_text_color: "Custom"

                text_color:
                    0.15, 0.15, 0.15, 1

                elevation: 1

                on_release:
                    root.continue_with_google()

            # ==============================================
            # SIGNUP
            # ==============================================

            MDLabel:
                text: "Don't have an account?"

                halign: "center"

                theme_text_color: "Secondary"

                size_hint_y: None
                height: dp(30)

            MDTextButton:
                text: "CREATE ACCOUNT"

                pos_hint:
                    {"center_x": 0.5}

                theme_text_color: "Custom"

                text_color:
                    0.35, 0.15, 0.65, 1

                size_hint_y: None
                height: dp(45)

                on_release:
                    root.go_to_signup()

            Widget:
                size_hint_y: None
                height: dp(20)