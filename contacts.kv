#:import dp kivy.metrics.dp
#:import sp kivy.metrics.sp


# ==========================================================
# CONTACT ROW
# ==========================================================

<ContactRow>:

    orientation: "horizontal"

    size_hint_y: None
    height: dp(92)

    padding: dp(8), dp(6)
    spacing: dp(5)

    canvas.before:

        Color:
            rgba: 1, 1, 1, 1

        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(14), dp(14), dp(14), dp(14)]


    # ======================================================
    # PROFILE PHOTO
    # ======================================================

    FitImage:

        id: profile_image

        source: root.contact_photo if root.contact_photo else "assets/profile.png"

        size_hint:
            None, None

        size:
            dp(58), dp(58)

        radius:
            [dp(29), dp(29), dp(29), dp(29)]

        pos_hint:
            {"center_y": 0.5}


    # ======================================================
    # CONTACT DETAILS
    # ======================================================

    MDBoxLayout:

        orientation: "vertical"

        spacing: dp(1)

        padding: 0, dp(5)

        size_hint_x: 1


        MDLabel:

            text: root.contact_name

            font_size: sp(15)

            bold: True

            theme_text_color: "Custom"

            text_color:
                0.12, 0.12, 0.18, 1

            shorten: True

            shorten_from: "right"


        MDLabel:

            text: root.contact_phone

            font_size: sp(12)

            theme_text_color: "Secondary"

            shorten: True

            shorten_from: "right"


    # ======================================================
    # CALL
    # ======================================================

    MDIconButton:

        icon: "phone"

        icon_size: "23sp"

        theme_icon_color: "Custom"

        icon_color:
            0.08, 0.67, 0.38, 1

        size_hint_x: None

        width: dp(42)

        pos_hint:
            {"center_y": 0.5}

        on_release:
            root.call_pressed()


    # ======================================================
    # EDIT
    # ======================================================

    MDIconButton:

        icon: "pencil-outline"

        icon_size: "22sp"

        theme_icon_color: "Custom"

        icon_color:
            0.22, 0.18, 0.55, 1

        size_hint_x: None

        width: dp(42)

        pos_hint:
            {"center_y": 0.5}

        on_release:
            root.edit_pressed()


    # ======================================================
    # DELETE
    # ======================================================

    MDIconButton:

        icon: "delete-outline"

        icon_size: "22sp"

        theme_icon_color: "Custom"

        icon_color:
            0.85, 0.20, 0.20, 1

        size_hint_x: None

        width: dp(42)

        pos_hint:
            {"center_y": 0.5}

        on_release:
            root.delete_pressed()


# ==========================================================
# CONTACT SCREEN
# ==========================================================

<ContactsScreen>:

    MDFloatLayout:


        # ==================================================
        # BACKGROUND
        # ==================================================

        canvas.before:

            Color:
                rgba: 0.96, 0.97, 1, 1

            Rectangle:
                pos: self.pos
                size: self.size


        # ==================================================
        # HEADER
        # ==================================================

        MDCard:

            size_hint:
                1, None

            height:
                dp(72)

            pos_hint:
                {"top": 1}

            radius:
                [0, 0, 20, 20]

            elevation:
                5

            md_bg_color:
                1, 1, 1, 1


            MDBoxLayout:

                orientation:
                    "horizontal"

                padding:
                    dp(6), 0

                spacing:
                    dp(5)


                MDIconButton:

                    icon:
                        "arrow-left"

                    icon_size:
                        "28sp"

                    theme_icon_color:
                        "Custom"

                    icon_color:
                        0.22, 0.18, 0.55, 1

                    size_hint:
                        None, None

                    size:
                        dp(48), dp(48)

                    pos_hint:
                        {"center_y": 0.5}

                    on_release:
                        root.go_back()


                MDLabel:

                    text:
                        "Emergency Contacts"

                    font_size:
                        sp(20)

                    bold:
                        True

                    theme_text_color:
                        "Custom"

                    text_color:
                        0.22, 0.18, 0.55, 1

                    pos_hint:
                        {"center_y": 0.5}


        # ==================================================
        # MAIN CONTENT
        # ==================================================

        MDBoxLayout:

            orientation:
                "vertical"

            spacing:
                dp(10)

            padding:
                dp(14), dp(84), dp(14), dp(145)


            # =================================================
            # SEARCH
            # =================================================

            MDCard:

                size_hint_y:
                    None

                height:
                    dp(60)

                radius:
                    [16]

                elevation:
                    2

                md_bg_color:
                    1, 1, 1, 1

                padding:
                    dp(4)


                MDTextField:

                    id: search_field

                    hint_text:
                        "Search emergency contacts"

                    icon_right:
                        "magnify"

                    mode:
                        "rectangle"

                    multiline:
                        False

                    size_hint_y:
                        None

                    height:
                        dp(52)

                    on_text:
                        root.search_contact(self.text)


            # =================================================
            # TITLE / COUNT
            # =================================================

            MDBoxLayout:

                orientation:
                    "vertical"

                size_hint_y:
                    None

                height:
                    dp(55)

                padding:
                    dp(4), 0


                MDLabel:

                    text:
                        "Emergency Contacts"

                    font_size:
                        sp(17)

                    bold:
                        True

                    theme_text_color:
                        "Custom"

                    text_color:
                        0.14, 0.14, 0.20, 1

                    size_hint_y:
                        None

                    height:
                        dp(30)


                MDLabel:

                    id: contact_count

                    text:
                        "0 emergency contacts"

                    font_size:
                        sp(10)

                    theme_text_color:
                        "Secondary"

                    size_hint_y:
                        None

                    height:
                        dp(20)


            # =================================================
            # CONTACT LIST
            # =================================================

            MDCard:

                size_hint_y:
                    1

                radius:
                    [20]

                elevation:
                    2

                md_bg_color:
                    0.98, 0.98, 1, 1

                padding:
                    dp(8)


                ScrollView:

                    do_scroll_x:
                        False

                    do_scroll_y:
                        True

                    bar_width:
                        dp(4)


                    MDBoxLayout:

                        id: contact_list

                        orientation:
                            "vertical"

                        spacing:
                            dp(8)

                        padding:
                            dp(2)

                        size_hint_y:
                            None

                        height:
                            self.minimum_height


        # ==================================================
        # ADD CONTACT BUTTON
        # ==================================================

        MDRaisedButton:

            text:
                "＋  ADD EMERGENCY CONTACT"

            size_hint:
                None, None

            size:
                dp(260), dp(52)

            pos_hint:
                {"center_x": 0.5}

            y:
                dp(78)

            md_bg_color:
                0.35, 0.25, 0.90, 1

            text_color:
                1, 1, 1, 1

            on_release:
                root.add_contact()


        # ==================================================
        # COMMON FOOTER
        # ==================================================

        SafivoxFooter:

            id: contacts_footer

            size_hint:
                1, None

            height:
                dp(68)

            pos_hint:
                {"x": 0, "y": 0}